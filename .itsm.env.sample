# ============================================================================
#  .itsm.env.sample  —  ITSM tool credentials  (TEMPLATE)
# ============================================================================
#
#  WHAT THIS IS
#     Credentials for each ITSM tool, used ONLY by Stage 4 to log into the
#     tool directly and confirm that a ticket was actually created/closed.
#
#  HOW TO USE
#     1.  cp .itsm.env.sample .itsm.env
#     2.  Fill in ONLY the tools you actually use. Leave the rest blank —
#         a tool with blank credentials is simply skipped (reported as
#         "not configured", never as a failure).
#     3.  chmod 600 .itsm.env            # readable only by you
#     4.  NEVER commit .itsm.env — it is already in .gitignore.
#
#  ⚠️  EVERY developer must use THEIR OWN personal ITSM accounts here.
#      The values below are placeholders and will NOT work.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────
#  ServiceNow        (REST — basic auth)
# ──────────────────────────────────────────────────────────────────────────
#  SNOW_URL      : your instance base URL, e.g. https://devXXXXX.service-now.com
#  SNOW_USER     : a user with read access to the incident table
#  SNOW_PASSWORD : that user's password
export SNOW_URL=""
export SNOW_USER=""
export SNOW_PASSWORD=""


# ──────────────────────────────────────────────────────────────────────────
#  Zoho Desk         (OAuth — refresh-token flow)
# ──────────────────────────────────────────────────────────────────────────
#  ZOHODESK_ORG_ID        : your Desk organization id
#  ZOHODESK_CLIENT_ID     : OAuth client id  (Zoho API console)
#  ZOHODESK_CLIENT_SECRET : OAuth client secret
#  ZOHODESK_REFRESH_TOKEN : long-lived refresh token (scope: Desk.tickets.READ)
#  ZOHODESK_ACCOUNTS_URL  : accounts server for your DC (default US shown)
#  ZOHODESK_API_URL       : Desk API host for your DC   (default US shown)
export ZOHODESK_ORG_ID=""
export ZOHODESK_CLIENT_ID=""
export ZOHODESK_CLIENT_SECRET=""
export ZOHODESK_REFRESH_TOKEN=""
export ZOHODESK_ACCOUNTS_URL="https://accounts.zoho.com"
export ZOHODESK_API_URL="https://desk.zoho.com"


# ──────────────────────────────────────────────────────────────────────────
#  ServiceDesk Plus Cloud (SDP On-Demand)   (OAuth — refresh-token flow)
# ──────────────────────────────────────────────────────────────────────────
#  SDP_PORTAL        : your SDP portal / instance name
#  SDP_CLIENT_ID     : OAuth client id  (Zoho API console)
#  SDP_CLIENT_SECRET : OAuth client secret
#  SDP_REFRESH_TOKEN : long-lived refresh token (scope: SDPOnDemand.requests.READ)
#  SDP_ACCOUNTS_URL  : accounts server for your DC (default US shown)
#  SDP_API_URL       : SDP API host for your DC     (default US shown)
export SDP_PORTAL=""
export SDP_CLIENT_ID=""
export SDP_CLIENT_SECRET=""
export SDP_REFRESH_TOKEN=""
export SDP_ACCOUNTS_URL="https://accounts.zoho.com"
export SDP_API_URL="https://sdpondemand.manageengine.com"


# ──────────────────────────────────────────────────────────────────────────
#  HaloITSM          (OAuth — client-credentials flow)
# ──────────────────────────────────────────────────────────────────────────
#  HALO_URL           : your Halo base URL, e.g. https://yourco.haloitsm.com
#  HALO_CLIENT_ID     : API client id   (Halo > Configuration > API)
#  HALO_CLIENT_SECRET : API client secret
#  HALO_TENANT        : your Halo tenant name (if your install uses one)
export HALO_URL=""
export HALO_CLIENT_ID=""
export HALO_CLIENT_SECRET=""
export HALO_TENANT=""


# ──────────────────────────────────────────────────────────────────────────
#  PagerDuty         (REST API token)
# ──────────────────────────────────────────────────────────────────────────
#  PAGERDUTY_API_KEY    : a REST API key (read-only is enough)
#  PAGERDUTY_USER_EMAIL : a valid user email on the account (required by the API)
#  PAGERDUTY_API_URL    : leave as default unless you have a custom endpoint
export PAGERDUTY_API_KEY=""
export PAGERDUTY_USER_EMAIL=""
export PAGERDUTY_API_URL="https://api.pagerduty.com"


# ──────────────────────────────────────────────────────────────────────────
#  TOPdesk           (REST — HTTP Basic with an Application Password)
# ──────────────────────────────────────────────────────────────────────────
#  TOPDESK_INSTANCE_URL : your instance base URL, e.g.
#                         https://yourco.topdesk.net   (NO trailing slash)
#  TOPDESK_USERNAME     : the TOPdesk operator login name (e.g. adrianb58)
#  TOPDESK_API_TOKEN    : an *Application Password* generated inside TOPdesk
#                         (My Settings → Application Passwords). This is NOT
#                         your normal login password — it is a dedicated token.
#  TOPDESK_PASSWORD     : OPTIONAL fallback — only used if TOPDESK_API_TOKEN is
#                         blank. Prefer the Application Password (token).
#  TOPDESK_CALLER_NAME  : OPTIONAL — only needed when CREATING tickets, which
#                         Site24x7 does, not this read-only verifier. Leave
#                         blank unless a future feature needs it.
#
#  HOW TO MINT THE APPLICATION PASSWORD (2 minutes, done once):
#     1. Log in to TOPdesk as the operator above.
#     2. Top-right avatar → My Settings → Application Passwords.
#     3. "Add" → name it "site24x7-automation" → Create → copy the token.
#     4. Paste it into TOPDESK_API_TOKEN below in YOUR LOCAL .itsm.env.
#
#  The verifier only needs the first three. It reads incidents back
#  (GET /tas/api/incidents) to confirm the "[Site24x7 Test Alert]" ticket
#  was really created — exactly like the other tools. READ-ONLY.
export TOPDESK_INSTANCE_URL=""
export TOPDESK_USERNAME=""
export TOPDESK_API_TOKEN=""
export TOPDESK_PASSWORD=""
export TOPDESK_CALLER_NAME=""
