# ============================================================================
#  .token.env.sample  —  Site24x7 / Zoho OAuth credentials  (TEMPLATE)
# ============================================================================
#
#  WHAT THIS IS
#     Credentials used by get_token.sh to mint a fresh Site24x7 OAuth access
#     token (valid ~1 hour) from a long-lived refresh_token. No browser needed.
#
#  HOW TO USE
#     1.  cp .token.env.sample .token.env
#     2.  Fill in YOUR OWN values below (see "HOW TO GET THESE" at the bottom).
#     3.  chmod 600 .token.env          # make it readable only by you
#     4.  NEVER commit .token.env — it is already in .gitignore.
#
#  ⚠️  EVERY developer must use THEIR OWN Site24x7 account credentials here.
#      The values below are placeholders and will NOT work.
# ============================================================================

# ---- REQUIRED: your Site24x7 OAuth app credentials -------------------------
export client_id="1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
export client_secret="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
export refresh_token="1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ---- REQUIRED: the Zoho accounts server for YOUR data center ----------------
#  Pick the one that matches YOUR grid / data center. Examples:
#     Local / QA   : https://accounts.localzoho.com
#     US           : https://accounts.zoho.com
#     EU           : https://accounts.zoho.eu
#     IN           : https://accounts.zoho.in
#     AU           : https://accounts.zoho.com.au
export accounts_url="https://accounts.localzoho.com"

# ============================================================================
#  HOW TO GET THESE  (one-time, ~5 minutes)
# ============================================================================
#
#  1. client_id + client_secret
#     --------------------------
#     * Go to the Zoho API console for your DC:
#         Local/QA : https://api-console.localzoho.com
#         US       : https://api-console.zoho.com
#     * Create a "Self Client" (or "Server-based Application").
#     * Copy the Client ID and Client Secret shown.
#
#  2. refresh_token
#     -------------
#     * In the Self Client, generate a grant token (code) with the scopes:
#           Site24x7.Admin.All , Site24x7.Operations.All , Site24x7.Reports.All
#       (Admin scope is required for the Stage-0 trigger-test API.)
#     * Exchange the grant token for a refresh_token (one-time curl):
#
#         curl -X POST "https://accounts.localzoho.com/oauth/v2/token" \
#           -d "grant_type=authorization_code" \
#           -d "client_id=YOUR_CLIENT_ID" \
#           -d "client_secret=YOUR_CLIENT_SECRET" \
#           -d "redirect_uri=YOUR_REDIRECT_URI" \
#           -d "code=THE_GRANT_TOKEN"
#
#     * Copy "refresh_token" from the JSON response into this file.
#       (Refresh tokens are long-lived — you only do this once.)
#
#  VERIFY
#     chmod +x get_token.sh
#     ./get_token.sh            # should print a long access token, no errors
# ============================================================================
